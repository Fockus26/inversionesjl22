{
  "name": "inversionesjl22",
  "private": true,
  "scripts": {
    "lint:php": "bash scripts/php-lint.sh",
    "context:backup": "bash scripts/context-backup.sh",
    "context:restore": "bash scripts/context-backup.sh --restore",
    "shots": "node scripts/pr-screenshots.ts .pr-shots.json",
    "local:up": "docker compose --env-file .env.local up -d",
    "local:sync": "docker compose --env-file .env.local --profile tools run --rm content-sync",
    "site:pull": "bash scripts/pull-site.sh",
    "local:wp": "docker compose --env-file .env.local --profile cli run --rm wpcli wp",
    "shots:publish": "bash scripts/publish-pr-shots.sh .pr-shots",
    "local:down": "docker compose --env-file .env.local down",
    "build:css": "sass --no-source-map --style=expanded wp-content/plugins/inversionesjl22-site/assets/scss/site.scss wp-content/plugins/inversionesjl22-site/assets/site.css",
    "demo:up": "bash scripts/demo-up.sh",
    "demo:down": "docker compose --env-file /dev/null -f docker-compose.demo.yml down",
    "demo:wp": "docker compose --env-file /dev/null -f docker-compose.demo.yml --profile cli run --rm wpcli wp"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "sass": "1.77.8"
  }
}
