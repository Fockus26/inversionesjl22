# Copia este archivo como .env.local y rellena los valores. .env.local no se sube al repo.
# Lo leen scripts/pull-site.sh y docker compose (--env-file .env.local).

# Hosting (panel / FTP)
HOSTING_USER=
HOSTING_PASSWORD=

# WordPress: cuenta de administrador
WP_ADMIN_USER=
WP_ADMIN_PASSWORD=

# WordPress: cuenta con rol storage_manager
WP_STORAGE_MANAGER_USER=
WP_STORAGE_MANAGER_PASSWORD=

# WordPress: cuenta con rol seo_manager
WP_SEO_MANAGER_USER=
WP_SEO_MANAGER_PASSWORD=

# Base de datos
DB_USERNAME=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- El sitio (kit: scripts/pull-site.sh y docker-compose.yml) ---
SITE_URL=https://inversionesjl22.com
SITE_PLUGIN=inversionesjl22-site
CHILD_THEME=woodmart-child
TABLE_PREFIX=wp_

# --- Copia local (docker-compose.yml) ---
LOCAL_URL=http://localhost:8080
LOCAL_PORT=8080
# Core y PHP de producción (wp core version; el PHP del hosting):
WP_IMAGE_TAG=7.1.4-php8.3-apache
WPCLI_IMAGE_TAG=cli-php8.3

# --- Acceso para bajar el sitio (pull-site.sh). Uno de los dos ---
# SSH (GoDaddy WordPress administrado; el usuario sale en el panel, "Ver o cambiar"):
# producción usuario@892841.us32.ssh.myftpupload.com · ensayo usuario@985270.us32.ssh.myftpupload.com
PULL_SSH=
PULL_SSH_PORT=22
# FTPS (TLS forzado; nunca FTP plano). Host = el nombre del certificado del servidor:
PULL_FTP_HOST=
PULL_FTP_USER=
PULL_FTP_PASSWORD=
# Raíz de WordPress en el servidor, relativa al home del usuario (o absoluta):
# GoDaddy WordPress administrado: suele ser html (confirmar con `ls` al entrar por SSH)
PULL_PATH=html
