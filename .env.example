# Copia este archivo como .env y rellena los valores. El .env no se sube al repo.

# Hosting (panel / FTP)
HOSTING_USER=
HOSTING_PASSWORD=

# WordPress: cuenta de administrador
WP_ADMIN_USER=
WP_ADMIN_PASSWORD=

# WordPress: cuenta con rol storage_manager
WP_STORAGE_MANAGER_USER=
WP_STORAGE_MANAGER_PASSWORD=

# WordPress: cuenta con rol seo_manager
WP_SEO_MANAGER_USER=
WP_SEO_MANAGER_PASSWORD=

# Base de datos
DB_USERNAME=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
